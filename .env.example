# Producción / Neon (pooler): agrega pgbouncer + límites de pool para evitar P2024 en dev.
# Local con SQLite ya no aplica: el proyecto usa PostgreSQL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&pgbouncer=true&connection_limit=1&pool_timeout=30&connect_timeout=30"
ADMIN_PASSWORD="cambiar-en-produccion"
ADMIN_SESSION_SECRET="genera-un-secreto-largo-aleatorio"

# Formulario de contacto → notificación por correo (Resend)
CONTACT_TO_EMAIL="hola@sofiaciabattoni.com"
RESEND_API_KEY=""
# Remitente verificado en Resend (dominio sofiaciabattoni.com), ej:
# RESEND_FROM="Soulful Branding <hola@sofiaciabattoni.com>"
RESEND_FROM=""

# URL canónica del sitio (Open Graph en producción, canonical). Producción: https://www.sofiaciabattoni.com
# En previews de Vercel, og:image usa automáticamente VERCEL_URL (mismo build desplegado).
NEXT_PUBLIC_SITE_URL="https://www.sofiaciabattoni.com"

# Google Analytics 4 (público; opcional si usás el ID por defecto en código)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-7HMFH56SV0"

# Tras enviar el formulario de contacto: «Ir al calendario» (Llamada de claridad)
# Si no se define, el fallback está en src/lib/contact-calendar.ts
NEXT_PUBLIC_GOOGLE_CALENDAR_URL="https://calendar.app.google/oFCEDWf1ZdA5n8oT6"

# Sesión Deep Dive — se envía desde la etapa Narrativa del ERP
NEXT_PUBLIC_DEEP_DIVE_CALENDAR_URL="https://calendar.app.google/zNFHRQaA91ZNx3e98"

# Vercel Blob (producción en Vercel). En local dev las subidas van a carpeta temporal del sistema
# (no hace falta token). Opcional para probar Blob en local:
BLOB_READ_WRITE_TOKEN=""

# Oráculo Raíz — video de presentación en Blob (subir con scripts/upload-oraculo-video.ts)
NEXT_PUBLIC_ORACULO_PRESENTATION_VIDEO_URL=""
# Oráculo Raíz — link de pago España (opcional)
NEXT_PUBLIC_ORACULO_ES_PAYMENT_URL=""

# Pre-brief (portal cliente, Bloque 8) — video de bienvenida opcional (YouTube/Vimeo)
QUOTE_DEFAULT_VIDEO_URL=""

# Presupuestos ERP — notificación extra (opcional, n8n)
# El ERP guarda el estado en Postgres; n8n solo recibe eventos (WhatsApp, recordatorios).
N8N_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""

# Cron Vercel: recordatorios de facturas por vencer (7d / 1d / día de vencimiento)
# Generá un secreto largo aleatorio. Vercel envía Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
